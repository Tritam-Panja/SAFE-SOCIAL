{
  "name": "fizzy-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Kids Social Media Platform - Global child-safe web platform",
  "main": "electron/main.js",
  "scripts": {
    "dev": "pnpm --parallel --filter @fizzy/* --filter fizzy-* run dev",
    "dev:web": "pnpm --filter @fizzy/web run dev",
    "dev:api": "pnpm --filter @fizzy/api run dev",
    "dev:electron": "concurrently \"pnpm run dev:web\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "pnpm --recursive run build",
    "build:electron": "pnpm run build && electron-builder --win nsis",
    "cap:sync": "pnpm --filter @fizzy/web exec cap sync android",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "test:api": "pnpm --filter @fizzy/api run test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @fizzy/api run db:generate",
    "db:migrate": "pnpm --filter @fizzy/api run db:migrate",
    "db:seed": "pnpm --filter @fizzy/api run db:seed"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "prettier": "^3.4.1",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.7.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "express-rate-limit": "^8.7.4"
  },
  "build": {
    "appId": "safe.fizzykids.desktop",
    "productName": "Fizzy",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "apps/web/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Fizzy"
    }
  }
}
