datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated/prisma-client"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  CHILD
  PARENT
  ADMIN
}

enum AgeGroup {
  JUNIOR // 6-8 years
  EXPLORER // 9-12 years
  TEEN // 13-17 years
}

enum ContentType {
  POST
  SHORT
  REEL
  COMMENT
  PROFILE_PHOTO
  PROFILE_BIO
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  REMOVED
}

enum ReviewDecision {
  APPROVE
  REJECT
  REQUEST_CHANGES
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  THUMBNAIL
}

enum ParentLinkStatus {
  PENDING
  CONFIRMED
  REVOKED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum NotificationType {
  CONTENT_SUBMITTED
  CONTENT_APPROVED
  CONTENT_REJECTED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  PARENT_CONSENT_REQUEST
  PARENT_ALERT
  SYSTEM_ALERT
}

// -------------------------------------------------------------
// USER & IDENTITY MODELS
// -------------------------------------------------------------

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  displayName      String
  email            String?   @unique
  passwordHash     String
  role             UserRole  @default(CHILD)
  ageGroup         AgeGroup?
  birthDate        DateTime?
  avatarUrl        String?
  pendingAvatarUrl String?
  bio              String?
  pendingBio       String?
  isActive         Boolean   @default(true)
  isVerified       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Profile relations
  childProfile  ChildProfile?
  parentProfile ParentProfile?

  // Sessions
  sessions Session[]

  // Author relations
  contents         Content[]
  submissions      ContentSubmission[]
  reviewsConducted ContentReview[]     @relation("AdminReviews")
  actionsConducted ModerationAction[]  @relation("AdminActions")
  comments         Comment[]
  reactions        Reaction[]

  // Social & Safety relations
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  friendshipsInitiated   Friendship[]    @relation("FriendshipsInitiated")
  friendshipsReceived    Friendship[]    @relation("FriendshipsReceived")
  reportsFiled           ContentReport[] @relation("ReportsFiled")
  notifications          Notification[]
  blockedUsers           BlockedUser[]   @relation("UserBlocks")
  blockedBy              BlockedUser[]   @relation("BlockedByUsers")
  auditLogsTriggered     AuditLog[]      @relation("AuditActor")

  @@index([role, ageGroup])
  @@index([username])
}

model ChildProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentLinkCode String   @unique @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parentLinks    ParentChildLink[]
  parentControls ParentControl?

  @@index([parentLinkCode])
}

model ParentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  childLinks ParentChildLink[]
}

model ParentChildLink {
  id               String           @id @default(uuid())
  parentId         String
  childId          String
  parent           ParentProfile    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child            ChildProfile     @relation(fields: [childId], references: [id], onDelete: Cascade)
  status           ParentLinkStatus @default(PENDING)
  verificationCode String?
  confirmedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([parentId, childId])
  @@index([status])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// -------------------------------------------------------------
// CONTENT & MEDIA MODELS
// -------------------------------------------------------------

model Content {
  id              String        @id @default(uuid())
  authorId        String
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type            ContentType
  status          ContentStatus @default(PENDING_REVIEW)
  title           String?
  caption         String?
  durationSeconds Int? // For Shorts and Reels (max 60)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Media assets (images, videos, thumbnails)
  mediaAssets MediaAsset[]

  // Separate Requested vs Approved Audiences (Strict Business Rule)
  requestedAudiences ContentRequestedAudience[]
  approvedAudiences  ContentApprovedAudience[]

  // Moderation & Lifecycle tracking
  submissions       ContentSubmission[]
  reviews           ContentReview[]
  moderationActions ModerationAction[]
  reports           ContentReport[]

  // Engagement
  comments  Comment[]
  reactions Reaction[]

  @@index([status, type])
  @@index([authorId, status])
  @@index([createdAt])
}

model MediaAsset {
  id              String    @id @default(uuid())
  contentId       String
  content         Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  mediaType       MediaType
  storageKey      String // S3 / R2 object key
  url             String // Public or signed URL
  mimeType        String
  fileSizeBytes   Int
  width           Int?
  height          Int?
  durationSeconds Int?
  isQuarantined   Boolean   @default(true) // Quarantined until admin approval
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([contentId])
  @@index([isQuarantined])
}

model ContentRequestedAudience {
  id        String   @id @default(uuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  ageGroup  AgeGroup
  createdAt DateTime @default(now())

  @@unique([contentId, ageGroup])
  @@index([contentId])
}

model ContentApprovedAudience {
  id        String   @id @default(uuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  ageGroup  AgeGroup
  createdAt DateTime @default(now())

  @@unique([contentId, ageGroup])
  @@index([contentId, ageGroup])
}

// -------------------------------------------------------------
// MODERATION, REVIEWS & AUDITING
// -------------------------------------------------------------

model ContentSubmission {
  id            String   @id @default(uuid())
  contentId     String
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  notes         String?
  submittedAt   DateTime @default(now())

  reviews ContentReview[]

  @@index([contentId])
  @@index([submittedAt])
}

model ContentReview {
  id             String            @id @default(uuid())
  submissionId   String
  submission     ContentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  contentId      String
  content        Content           @relation(fields: [contentId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User              @relation("AdminReviews", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision       ReviewDecision
  decisionReason String?
  internalNotes  String?
  createdAt      DateTime          @default(now())

  @@index([contentId])
  @@index([reviewerId])
  @@index([decision])
}

model ModerationAction {
  id             String        @id @default(uuid())
  contentId      String
  content        Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  adminId        String
  admin          User          @relation("AdminActions", fields: [adminId], references: [id], onDelete: Restrict)
  actionType     String // e.g. "APPROVE", "REJECT", "REMOVE", "QUARANTINE_MEDIA"
  previousStatus ContentStatus
  newStatus      ContentStatus
  reason         String?
  createdAt      DateTime      @default(now())

  @@index([contentId])
  @@index([adminId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "USER_LOGIN", "CONTENT_PUBLISHED", "PARENT_SETTING_CHANGED"
  entityType String // "Content", "User", "ParentControl", "Friendship"
  entityId   String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// SOCIAL INTERACTIONS & FRIENDSHIPS
// -------------------------------------------------------------

model Comment {
  id        String        @id @default(uuid())
  contentId String
  content   Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  status    ContentStatus @default(APPROVED) // In Junior/Explorer can be pre-screened
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([contentId, status])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(uuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String // Friendly emojis: "❤️", "⭐", "🎉", "🔥", "🎨"
  createdAt DateTime @default(now())

  // Prevent duplicate reaction of same emoji on same content by same user
  @@unique([contentId, userId, emoji])
  @@index([contentId])
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  sender     User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userA     User     @relation("FriendshipsInitiated", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("FriendshipsReceived", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Symmetrical friendship uniqueness constraint: userAId must be lexicographically < userBId
  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

// -------------------------------------------------------------
// SAFETY, PARENTAL CONTROLS & REPORTS
// -------------------------------------------------------------

model ParentControl {
  id                              String       @id @default(uuid())
  childProfileId                  String       @unique
  childProfile                    ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  dailyLimitMinutes               Int          @default(60)
  canWatchShortsReels             Boolean      @default(true)
  canCreateContent                Boolean      @default(true)
  canComment                      Boolean      @default(true)
  canAddFriends                   Boolean      @default(true)
  canReceiveFriendRequests        Boolean      @default(true)
  requireParentApprovalForFriends Boolean      @default(true)
  bedtimeStartHour                Int? // e.g. 21 for 9 PM
  bedtimeEndHour                  Int? // e.g. 7 for 7 AM
  isLocked                        Boolean      @default(false)
  isPaused                        Boolean      @default(false)
  pauseReason                     String?
  notifyOnFriendRequest           Boolean      @default(true)
  notifyOnContentStatus           Boolean      @default(true)
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt
}

model ContentReport {
  id          String       @id @default(uuid())
  contentId   String
  content     Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reason      String
  details     String?
  status      ReportStatus @default(PENDING)
  actionTaken String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([contentId])
  @@index([status])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  referenceId String? // ID of content, friend request, etc.
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// -------------------------------------------------------------
// TRANSACTIONAL OUTBOX FOR RELIABLE REAL-TIME EVENT DELIVERY
// -------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model EventOutbox {
  id           String       @id @default(uuid())
  eventType    String // e.g. 'feed:updated', 'content:approved'
  channelType  String // 'AGE_GROUP', 'USER', 'ADMIN', 'FAMILY'
  target       String // e.g. 'TEEN', 'user:<userId>', 'role:admin'
  payloadJson  String // JSON payload
  status       OutboxStatus @default(PENDING)
  retryCount   Int          @default(0)
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
}
