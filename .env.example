# ==============================================================================
# FIZZY PLATFORM CONFIGURATION TEMPLATE
# Global Child-Safe Social Media Platform
# Copy this file to .env and adjust variables for your target environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
CLIENT_ORIGIN=https://app.fizzykids.safe
SESSION_SECRET=replace_with_a_cryptographically_secure_random_64_byte_hex_string
SESSION_MAX_AGE_MS=86400000

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Standard connection string format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fizzy_prod?schema=public

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN BOOTSTRAP (Zero-Trust Setup)
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_USERNAME=safety_admin
ADMIN_BOOTSTRAP_EMAIL=admin@fizzykids.safe
ADMIN_BOOTSTRAP_PASSWORD=ChangeThisPasswordImmediately123!
ADMIN_BOOTSTRAP_NAME="Lead Safety Moderator"

# ------------------------------------------------------------------------------
# 4. STORAGE & CLOUDFLARE R2 MEDIA CONFIGURATION
# ------------------------------------------------------------------------------
# STORAGE_DRIVER options: 'r2' (production), 's3' (AWS S3), or 'local' (isolated dev)
STORAGE_DRIVER=r2

# Cloudflare Account ID & R2 API Tokens (S3-compatible API credentials)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Dedicated Private Buckets (Never make quarantine public!)
R2_BUCKET_QUARANTINE=fizzy-media-quarantine
R2_BUCKET_APPROVED=fizzy-media-approved

# Custom Domain or Cloudflare Worker for CDN delivery of approved assets
R2_PUBLIC_DOMAIN=https://cdn.fizzykids.safe

# ------------------------------------------------------------------------------
# 5. FRONTEND WEB CLIENT (Vite)
# ------------------------------------------------------------------------------
# Used by apps/web during build or runtime
VITE_API_URL=https://api.fizzykids.safe/api/v1
